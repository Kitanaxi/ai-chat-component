# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Manter no Git o ChatIA, o botão do dashboard, a documentação e este ficheiro.
/*
!/.gitignore
!/README.md
!/app/
/app/*
!/app/dashboard/
/app/dashboard/*
!/app/dashboard/page.tsx
!/components/
/components/*
!/components/chat-ia/
!/components/chat-ia/**
!/components/site-header.tsx
